<section class="shop-section" id="shop">
  <h2 class="section-title">{{ section.settings.heading | default: 'SHOP THE LATEST...' }}</h2>
  <div class="product-grid">
    {% if section.settings.collection != blank %}
      {% for product in section.settings.collection.products limit: section.settings.products_to_show %}
        <article class="product-card {% unless product.available %}sold-out{% endunless %} {% if product.compare_at_price > product.price %}sale{% endif %}">
          <a href="{{ product.url }}" class="product-image">
            {% if product.featured_image %}
              <img src="{{ product.featured_image | image_url: width: 520 }}" alt="{{ product.featured_image.alt | escape }}" loading="lazy" width="260" height="260" />
            {% else %}
              <div class="placeholder-img burnout"></div>
            {% endif %}
            <span class="product-badge">{% if product.available %}Choose options{% else %}Sold out{% endif %}</span>
            {% if product.compare_at_price > product.price %}
              <span class="save-badge">Save {{ product.compare_at_price | minus: product.price | money }}</span>
            {% endif %}
          </a>
          <h3 class="product-name"><a href="{{ product.url }}">{{ product.title }}</a></h3>
          <p class="product-price">
            {% if product.compare_at_price > product.price %}
              Sale price <strong>{{ product.price | money }}</strong> <s>{{ product.compare_at_price | money }}</s>
            {% else %}
              {{ product.price | money }}
            {% endif %}
          </p>
          {% if product.available %}
            <a href="{{ product.url }}" class="btn-add">Choose options</a>
          {% endif %}
        </article>
      {% endfor %}
    {% else %}
      {% comment %} Placeholder products when no collection selected {% endcomment %}
      {% for i in (1..4) %}
        <article class="product-card">
          <div class="product-image">
            <div class="placeholder-img burnout"></div>
            <span class="product-badge">Choose options</span>
          </div>
          <h3 class="product-name">Product {{ i }}</h3>
          <p class="product-price">Sale price <strong>$0.00</strong></p>
          <a href="/collections/all" class="btn-add">Choose options</a>
        </article>
      {% endfor %}
    {% endif %}
  </div>
  <div class="shop-cta">
    <a href="{{ section.settings.button_link | default: '/collections/all' }}" class="btn-primary">{{ section.settings.button_text | default: 'SHOP ALL' }}</a>
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "tag": "section",
  "class": "section-shop",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SHOP THE LATEST..."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8,
      "label": "Products to show"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "SHOP ALL"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ]
}
{% endschema %}
